{
  "name": "@robotic-harness/dsh-bundle",
  "version": "0.1.0",
  "description": "Robotic Harness — embodied-intelligence research plugin suite for DeepSeek Harness (demo): asset inspection, MuJoCo pick-place simulation, diagnostics, evidence bundles and data quality tools.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./tools": "./lib/tools.js",
    "./skills": "./lib/skills.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "worker",
    "scenarios",
    "fixtures",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/sync-worker.mjs && tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/sync-worker.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
