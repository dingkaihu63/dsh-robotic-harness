<?xml version="1.0"?>
<!-- Minimal SDF fixture for the rh_sdf_validate tool. -->
<sdf version="1.9">
  <model name="rh_demo_arm">
    <link name="base_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.0006</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="link1">
      <pose>0 0 0.22 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.0061</ixx><iyy>0.0061</iyy><izz>0.0007</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="shoulder" type="revolute">
      <parent>base_link</parent>
      <child>link1</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-3.0</lower>
          <upper>3.0</upper>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
