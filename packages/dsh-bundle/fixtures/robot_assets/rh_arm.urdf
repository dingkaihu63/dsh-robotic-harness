<?xml version="1.0"?>
<!--
  Robotic Harness demo arm: planar 3-DOF arm (shoulder, elbow, wrist) with a
  suction cup. Mirrors the MuJoCo scenario geometry so URDF -> MJCF
  conversion produces a working model. Units: meters, kilograms, radians.
-->
<robot name="rh_arm">
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.035"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0.11 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.22"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.11 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.22"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.11 0 0" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.0061" ixy="0" ixz="0" iyy="0.0061" iyz="0" izz="0.0007"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0.095 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.19"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.095 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.19"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.095 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0027" ixy="0" ixz="0" iyy="0.0027" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="0.028 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.11"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.028 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.11"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.028 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <link name="cup">
    <visual>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.03"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.036 0.036 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="base_to_link1" type="fixed">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <joint name="shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.22 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.0" upper="3.0" effort="20" velocity="2.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.19 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="2.9" effort="12" velocity="2.0"/>
  </joint>

  <joint name="wrist_joint" type="revolute">
    <parent link="link3"/>
    <child link="cup"/>
    <origin xyz="0.19 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="4" velocity="3.0"/>
  </joint>
</robot>
